#!/usr/bin/env python3
"""Add context tags to desktop entries so Fuzzel finds apps by what they do.

Copies each tagged entry to ~/.local/share/applications with extra Keywords= (the copy shadows the system one).
Tags come from the category map below and from ~/.config/fuzzel/tags.conf. Run again after editing the file or after app updates.
"""
import os, re, glob

HOME = os.path.expanduser("~")
OUT = f"{HOME}/.local/share/applications"
MARK = "# generated by fuzzel-tags"
SRC = ["/usr/share/applications", "/var/lib/flatpak/exports/share/applications", f"{HOME}/.local/share/flatpak/exports/share/applications"]

CATEGORY_TAGS = {
    "FileManager": "file manager explorer finder folders",
    "WebBrowser": "browser internet web",
    "Network": "internet network online",
    "Email": "mail email inbox",
    "InstantMessaging": "chat messaging",
    "Chat": "chat messaging",
    "TerminalEmulator": "terminal console shell command line",
    "TextEditor": "text editor notes write",
    "IDE": "code editor programming development",
    "Development": "programming code developer",
    "Audio": "music sound audio",
    "Music": "music songs player",
    "Video": "video movies player",
    "AudioVideo": "media multimedia",
    "Player": "player media",
    "Graphics": "images graphics design",
    "Photography": "photos images camera",
    "ImageProcessing": "image editor photos",
    "Viewer": "viewer open",
    "Office": "office documents",
    "WordProcessor": "word documents writing",
    "Spreadsheet": "spreadsheet excel tables",
    "Presentation": "slides presentation powerpoint",
    "Game": "game games play",
    "Settings": "settings preferences configuration options",
    "DesktopSettings": "settings desktop appearance",
    "HardwareSettings": "settings hardware devices",
    "Monitor": "monitor system status",
    "System": "system administration",
    "Archiving": "archive zip extract compress",
    "Compression": "archive zip extract compress",
    "Utility": "utility tool",
    "PackageManager": "install software packages updates store",
    "Science": "science math",
    "Education": "learn study education",
    "Calculator": "calculator math numbers",
    "Printing": "print printer",
    "Security": "security passwords privacy",
}

def read_rules():
    rules = []
    try:
        for line in open(f"{HOME}/.config/fuzzel/tags.conf"):
            line = line.strip()
            if line and not line.startswith("#") and ":" in line:
                pat, tags = line.split(":", 1)
                rules.append((pat.strip().lower(), tags.split()))
    except FileNotFoundError:
        pass
    return rules

def entry_field(lines, key):
    for l in lines:
        if l.startswith(key + "="):
            return l.split("=", 1)[1].strip()
    return ""

def main():
    os.makedirs(OUT, exist_ok=True)
    for f in glob.glob(f"{OUT}/*.desktop"):
        if MARK in open(f, errors="ignore").read(200):
            os.remove(f)
    rules = read_rules()
    made = 0
    seen = set()
    for d in SRC:
        for path in sorted(glob.glob(f"{d}/**/*.desktop", recursive=True)):
            name = os.path.relpath(path, d).replace("/", "-")
            if name in seen or os.path.exists(f"{OUT}/{name}"):
                continue
            seen.add(name)
            text = open(path, errors="ignore").read()
            head = text.split("\n[", 1)[0].split("\n")
            if entry_field(head, "Type") != "Application" or entry_field(head, "NoDisplay").lower() == "true":
                continue
            tags = []
            for c in entry_field(head, "Categories").split(";"):
                tags += CATEGORY_TAGS.get(c, "").split()
            hay = (name + " " + entry_field(head, "Name")).lower()
            for pat, t in rules:
                if pat in hay:
                    tags += t
            existing = [k for k in entry_field(head, "Keywords").split(";") if k]
            new = [t for t in dict.fromkeys(tags) if t not in [e.lower() for e in existing]]
            if not new:
                continue
            kw = ";".join(existing + new) + ";"
            lines = text.split("\n")
            end = next((i for i, l in enumerate(lines) if i and l.startswith("[")), len(lines))
            idx = next((i for i in range(end) if lines[i].startswith("Keywords=")), None)
            if idx is not None:
                lines[idx] = "Keywords=" + kw
            else:
                lines.insert(end, "Keywords=" + kw)
            open(f"{OUT}/{name}", "w").write(f"{MARK}\n" + "\n".join(lines))
            made += 1
    print(f"tagged {made} apps")

main()
